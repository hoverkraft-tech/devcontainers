LINTER_IMAGE := ghcr.io/hoverkraft-tech/docker-base-images/super-linter:2.0.2@sha256:12dedee667b43856a9cc792628fecc4723fc0868bf8090d268981407a7402b2c

.PHONY: lint test

lint:
	docker run --rm \
		-v "$(CURDIR):/tmp/lint:ro" \
		-e RUN_LOCAL=true \
		-e USE_FIND_ALGORITHM=true \
		-e VALIDATE_GIT_COMMITLINT=false \
		-e 'FILTER_REGEX_EXCLUDE=(^|/)(node_modules|\.cache|\.git)/|(^|/)src/[^/]+/README\.md$$' \
		$(LINTER_IMAGE)

test:
	@set -eu; \
	for image in debian:latest ubuntu:latest mcr.microsoft.com/devcontainers/base:ubuntu; do \
		npx --no-install devcontainer features test --skip-scenarios -f asdf -i "$$image" .; \
	done
	npx --no-install devcontainer features test -f asdf --skip-autogenerated --skip-duplicated .
